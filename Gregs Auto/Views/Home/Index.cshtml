@using Gregs_Auto.ViewModels
@model List<ServiceRowViewModel>

@{
    ViewData["Title"] = "Home";
}

@section Hero {
    <section class="ga-hero">
        <div class="container">
            <div class="row">
                <div class="col-lg-9">
                    <div class="ga-eyebrow">Service You Can Trust!</div>
                    <h1>Straight answers, honest repairs.</h1>
                    <p class="lead">
                        From a routine oil change to a full brake job, we'll tell you what your
                        vehicle actually needs &mdash; and what it doesn't. Book online in under a minute.
                    </p>
                    <a class="btn btn-primary btn-lg" asp-controller="Appointments" asp-action="Schedule">Book a Service</a>
                    <a class="btn btn-on-blue btn-lg ms-2" asp-controller="Services" asp-action="Index">See Pricing</a>

                    <div class="ga-hero-services">
                        <span>Brakes</span><span class="ga-contact-sep">|</span><span>Tires</span><span class="ga-contact-sep">|</span><span>Exhaust</span><span class="ga-contact-sep">|</span><span>Diagnostics</span><span class="ga-contact-sep">|</span><span>Oil Changes</span><span class="ga-contact-sep">|</span><span>Towing</span><span class="ga-contact-sep">|</span><span>Cooling Systems</span><span class="ga-contact-sep">|</span><span>Batteries</span><span class="ga-contact-sep">|</span><span>Alignments</span><span class="ga-contact-sep">|</span><span>Plus Much More</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<div class="row g-4 my-1">
    <div class="col-md-4">
        <div class="ga-card">
            <h3>Upfront Pricing</h3>
            <p>Every service is priced on our site before you walk in. No surprise line items when you pick up.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ga-card">
            <h3>Quality Parts</h3>
            <p>We install Jasper engines and transmissions, backed by a nationwide parts and labor warranty.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="ga-card">
            <h3>We Keep Your History</h3>
            <p>Every visit is logged against your vehicle, so we know what was done and when it's due again.</p>
        </div>
    </div>
</div>

@if (Model.Any())
{
    <div class="d-flex justify-content-between align-items-end mb-3 mt-5">
        <div>
            <h2 class="ga-page-title">Popular Services</h2>
            <p class="ga-page-sub mb-0">Our most-booked work, priced up front.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-controller="Services" asp-action="Index">All services</a>
    </div>

    <div class="row g-4">
        @foreach (var s in Model)
        {
            <div class="col-md-4">
                <div class="ga-card d-flex flex-column">
                    <h3>@s.Name</h3>
                    <p class="flex-grow-1">@(s.Description ?? "")</p>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <span class="ga-price fs-5">@(s.Price > 0 ? s.Price.ToString("C") : "Free")</span>
                        <span class="text-muted small">@s.EstimatedDurationMinutes min</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="ga-panel d-flex flex-wrap justify-content-between align-items-center gap-3 mt-5">
    <div>
        <h2 class="ga-page-title h4 mb-1">Ready to get on the schedule?</h2>
        <p class="mb-0 text-muted">Pick your vehicle, choose a service, and grab a time that works.</p>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-primary" asp-controller="Appointments" asp-action="Schedule">Book Online</a>
        <a class="btn btn-outline-secondary" href="tel:+16365288204">Call 636.528.8204</a>
    </div>
</div>
