@{
    ViewData["Title"] = "Request Received";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <h1 class="ga-page-title">Thanks &mdash; we've got it.</h1>
        <p class="ga-page-sub">
            Your request is in front of the shop. Someone will call to confirm the
            time before it goes on the books, so hang onto your slot until you hear
            from us.
        </p>

        <div class="ga-panel">
            <p class="mb-3">
                Need it sooner, or want to talk it through first? Give us a ring &mdash;
                that's usually quicker than waiting on the callback.
            </p>
            <a class="btn btn-primary" href="tel:+16365288204">Call 636.528.8204</a>
            <a class="btn btn-outline-secondary ms-2" asp-controller="Services" asp-action="Index">See all services</a>
            <a class="btn btn-outline-secondary ms-2" asp-controller="Home" asp-action="Index">Back home</a>
        </div>
    </div>
</div>
