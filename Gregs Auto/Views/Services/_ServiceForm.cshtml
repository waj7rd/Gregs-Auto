@using Gregs_Auto.ViewModels
@model EditServiceViewModel

@* Shared by Create and Edit — the only difference is whether ServiceId is set,
   so keeping one form stops the two drifting apart. *@

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="ga-page-title">@(Model.IsNew ? "Add a Service" : "Edit Service")</h1>
        <p class="ga-page-sub">
            The time you set here is what the booking rules use to stop two jobs
            landing on top of each other.
        </p>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <div class="ga-panel">
            <form asp-controller="Services" asp-action="@(Model.IsNew ? "Create" : "Edit")" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="ServiceId" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" autofocus placeholder="Oil Change" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2"
                              placeholder="Conventional oil and filter change"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="EstimatedDurationMinutes" class="form-label"></label>
                        <input asp-for="EstimatedDurationMinutes" class="form-control" />
                        <span asp-validation-for="EstimatedDurationMinutes" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Price" class="form-label"></label>
                        <input asp-for="Price" class="form-control" />
                        <div class="form-text">Use 0 for something you don't charge for.</div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">@(Model.IsNew ? "Add service" : "Save changes")</button>
                <a class="btn btn-outline-secondary ms-2" asp-action="Manage">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
