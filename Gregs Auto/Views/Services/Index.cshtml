@using Gregs_Auto.ViewModels
@model List<ServiceRowViewModel>

@{
    ViewData["Title"] = "Auto Repair Services & Pricing | Troy, MO";
    ViewData["MetaDescription"] = "Every service at Greg's Automotive in Troy, MO — oil changes, brakes, tires, diagnostics, alignments, and more. Upfront prices, no surprise line items.";
}

<h1 class="ga-page-title">Services &amp; Pricing</h1>
<p class="ga-page-sub">What we do, how long it takes, and what it costs.</p>

@if (!Model.Any())
{
    <p class="text-muted">No services in the catalog yet.</p>
}
else
{
    <div class="row g-4 mb-4">
        @foreach (var s in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="ga-card d-flex flex-column">
                    <h3>@s.Name</h3>
                    <p class="flex-grow-1">@(s.Description ?? "")</p>
                    <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                        <div>
                            <div class="ga-price fs-5">@(s.Price > 0 ? s.Price.ToString("C") : "Free")</div>
                            <div class="text-muted small">about @s.EstimatedDurationMinutes min</div>
                        </div>
                        <a class="btn btn-sm btn-primary" asp-controller="Appointments" asp-action="Schedule">Book</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
