@using Gregs_Auto.ViewModels
@model ResetStaffPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-5">
        <h1 class="ga-page-title">Reset Password</h1>
        <p class="ga-page-sub">Setting a new password for <strong>@Model.FullName</strong>. This also clears any lockout.</p>

        @if (Model.ErrorMessage != null)
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        <div class="ga-panel">
            <form asp-controller="Staff" asp-action="ResetPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="FullName" />

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autofocus />
                    <div class="form-text">At least 10 characters.</div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary">Reset password</button>
                <a class="btn btn-outline-secondary ms-2" asp-action="Index">Cancel</a>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
