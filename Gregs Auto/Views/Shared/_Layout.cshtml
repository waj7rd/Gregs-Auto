@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string c, string? a = null) =>
        controller == c && (a == null || action == a) ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Greg's Auto</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md ga-navbar">
            <div class="container">
                <a class="navbar-brand ga-brand" asp-controller="Home" asp-action="Index">
                    Greg's<span class="ga-brand-accent">Auto</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gaNav"
                        aria-controls="gaNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="gaNav">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Services")" asp-controller="Services" asp-action="Index">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Appointments", "Schedule")" asp-controller="Appointments" asp-action="Schedule">Book a Service</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Appointments", "Manage")" asp-controller="Appointments" asp-action="Manage">Schedule</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Customers")" asp-controller="Customers" asp-action="Index">Customers</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-md-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-md-3">
                                <span class="ga-user">@User.Identity!.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-light-amber">Log Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-light-amber" asp-controller="Account" asp-action="Login">Staff Log In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @* Full-bleed slot for the home page hero; every other view just gets
           the centered container below. *@
        @await RenderSectionAsync("Hero", required: false)
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="ga-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span><span class="ga-footer-brand">Greg's Auto</span> &mdash; honest service since 1998</span>
            <span>&copy; @DateTime.Now.Year Greg's Auto</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
