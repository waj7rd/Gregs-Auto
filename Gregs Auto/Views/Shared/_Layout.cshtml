@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string NavClass(string c, string? a = null) =>
        controller == c && (a == null || action == a) ? "nav-link active" : "nav-link";

    // Replace YOUR-DOMAIN.com with the live domain before launch.
    const string SiteDomain = "https://YOUR-DOMAIN.com";

    var metaDesc = ViewData["MetaDescription"] as string
        ?? "Greg's Automotive in Troy, MO — honest repairs and fair prices. Oil changes, brakes, tires, diagnostics, and more. Book online in under a minute.";

    var canonicalUrl = SiteDomain + Context.Request.Path;
    var ogTitle     = (ViewData["Title"] as string ?? "Greg's Automotive") + " · Greg's Automotive";

    // Staff screens and thin confirmation pages shouldn't earn a search result.
    // Kept in step with wwwroot/robots.txt: that file asks crawlers not to fetch
    // these, this covers the ones they reach from a link anyway. A view can force
    // the decision either way with ViewData["NoIndex"].
    var noIndex = ViewData["NoIndex"] as bool? ?? (controller, action) switch
    {
        ("Account", _) or ("Customers", _) or ("Settings", _) or ("Staff", _) => true,
        ("Appointments", "Manage") or ("Appointments", "Requests") or ("Appointments", "Requested") => true,
        ("Services", "Manage") or ("Services", "Create") or ("Services", "Edit") => true,
        ("Home", "Error") => true,
        _ => false
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] &middot; Greg's Automotive</title>
    @if (noIndex)
    {
        <meta name="robots" content="noindex, follow" />
    }

    <!-- SEO: description & canonical -->
    <meta name="description" content="@metaDesc" />
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:site_name"   content="Greg's Automotive" />
    <meta property="og:title"       content="@ogTitle" />
    <meta property="og:description" content="@metaDesc" />
    <meta property="og:url"         content="@canonicalUrl" />
    <meta property="og:image"       content="@(SiteDomain)/images/og-image.jpg" />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary" />
    <meta name="twitter:title"       content="@ogTitle" />
    <meta name="twitter:description" content="@metaDesc" />

    @* JSON-LD lives in the markup rather than a C# string: Razor's tokenizer
       rejects raw string literals ("""), and verbatim strings would mean
       doubling every quote in the JSON. In markup, @@ escapes a literal @,
       and the url below reuses the same SiteDomain as the canonical tag. *@
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "AutoRepair",
          "name": "Greg's Automotive",
          "description": "Honest auto repair in Troy, MO. Oil changes, brakes, tires, diagnostics, alignments, and more.",
          "url": "@SiteDomain",
          "telephone": "+16365288204",
          "address": {
            "@@type": "PostalAddress",
            "streetAddress": "396 Travis Blvd",
            "addressLocality": "Troy",
            "addressRegion": "MO",
            "postalCode": "63379",
            "addressCountry": "US"
          },
          "priceRange": "$$",
          "sameAs": [
            "https://YOUR-GOOGLE-BUSINESS-PROFILE-URL"
          ]
        }
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="ga-header">
        <nav class="navbar navbar-expand-lg ga-navbar">
            <div class="container">
                <a class="navbar-brand p-0 me-4" asp-controller="Home" asp-action="Index">
                    @* Drop the shop's logo at wwwroot/images/logo.png and it replaces the
                       text wordmark automatically; the fallback keeps the header intact
                       until then. *@
                    <img src="~/images/logo.png" alt="Greg's Automotive — Service You Can Trust!"
                         class="ga-logo"
                         onerror="this.style.display='none';document.getElementById('ga-wordmark').style.display='block';" />
                    <span class="ga-wordmark" id="ga-wordmark" style="display:none;">
                        <span class="ga-wordmark-name">Greg's <span>Automotive</span></span>
                        <span class="ga-wordmark-tag">Service You Can Trust!</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#gaNav"
                        aria-controls="gaNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="gaNav">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="@NavClass("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Services")" asp-controller="Services" asp-action="Index">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="@NavClass("Appointments", "Schedule")" asp-controller="Appointments" asp-action="Schedule">Book a Service</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="@NavClass("Appointments", "Manage")" asp-controller="Appointments" asp-action="Manage">Schedule</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Appointments", "Requests")" asp-controller="Appointments" asp-action="Requests">Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Customers")" asp-controller="Customers" asp-action="Index">Customers</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Services", "Manage")" asp-controller="Services" asp-action="Manage">Catalog</a>
                            </li>
                            <li class="nav-item">
                                <a class="@NavClass("Settings")" asp-controller="Settings" asp-action="Index">Settings</a>
                            </li>
                            @if (User.IsInRole(Gregs_Auto.Domain.Identity.Roles.Admin))
                            {
                                <li class="nav-item">
                                    <a class="@NavClass("Staff")" asp-controller="Staff" asp-action="Index">Staff</a>
                                </li>
                            }
                        }
                    </ul>
                    <ul class="navbar-nav align-items-lg-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-lg-3">
                                <a class="ga-user text-decoration-none" asp-controller="Account" asp-action="ChangePassword"
                                   title="Change your password">@User.Identity!.Name</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">Log Out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Account" asp-action="Login">Staff Log In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>

        <div class="ga-checker"></div>

        <div class="ga-contact-bar">
            <div class="container text-center">
                <a href="tel:+16365288204">636.528.8204</a>
                <span class="ga-contact-sep">|</span>
                <span>396 TRAVIS BLVD</span>
                <span class="ga-contact-sep">|</span>
                <span>TROY, MO 63379</span>
            </div>
        </div>
    </header>

    <main role="main">
        @* Full-bleed slot for the home page hero; every other view just gets
           the centered container below. *@
        @await RenderSectionAsync("Hero", required: false)
        <div class="container @(IsSectionDefined("Hero") ? "" : "pt-4")">
            @RenderBody()
        </div>
    </main>

    <footer class="ga-footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <div class="ga-footer-brand mb-2">Greg's Automotive</div>
                    <div>Service You Can Trust!</div>
                </div>
                <div class="col-md-4">
                    <div class="ga-footer-brand mb-2">Visit Us</div>
                    <div>396 Travis Blvd</div>
                    <div>Troy, MO 63379</div>
                </div>
                <div class="col-md-3">
                    <div class="ga-footer-brand mb-2">Call Us</div>
                    <div><a href="tel:+16365288204">636.528.8204</a></div>
                </div>
            </div>
            <hr class="border-light opacity-25 my-4" />
            <div>&copy; @DateTime.Now.Year Greg's Automotive</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
