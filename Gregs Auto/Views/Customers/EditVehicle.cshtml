@using Gregs_Auto.ViewModels
@model EditVehicleViewModel

@{
    ViewData["Title"] = "Edit Vehicle";
}

<h1 class="ga-page-title">Edit Vehicle</h1>
<p class="ga-page-sub">@Model.Year @Model.Make @Model.Model</p>

<div class="row">
    <div class="col-md-6 col-lg-5">
        <div class="ga-panel">
            <form asp-controller="Customers" asp-action="EditVehicle" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="VehicleId" />
                <input type="hidden" asp-for="CustomerId" />

                <div class="row g-3">
                    <div class="col-4">
                        <label asp-for="Year" class="form-label"></label>
                        <input asp-for="Year" class="form-control" type="number" />
                    </div>
                    <div class="col-8">
                        <label asp-for="Make" class="form-label"></label>
                        <input asp-for="Make" class="form-control" />
                    </div>
                    <div class="col-12">
                        <span asp-validation-for="Year" class="text-danger small"></span>
                        <span asp-validation-for="Make" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Model" class="form-label"></label>
                        <input asp-for="Model" class="form-control" />
                        <span asp-validation-for="Model" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Vin" class="form-label"></label>
                        <input asp-for="Vin" class="form-control" placeholder="17 characters, optional" />
                        <span asp-validation-for="Vin" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="LicensePlate" class="form-label"></label>
                        <input asp-for="LicensePlate" class="form-control" />
                        <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Save</button>
                    <a class="btn btn-outline-secondary" asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
