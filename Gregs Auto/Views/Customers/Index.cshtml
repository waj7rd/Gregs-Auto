@using Gregs_Auto.ViewModels
@model List<CustomerRowViewModel>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex justify-content-between align-items-end mb-4">
    <div>
        <h1 class="ga-page-title">Customers</h1>
        <p class="ga-page-sub mb-0">@Model.Count customer(s) on file.</p>
    </div>
    <a class="btn btn-primary" asp-controller="Customers" asp-action="Create">Add Customer</a>
</div>

@if (!Model.Any())
{
    <p class="text-muted">No customers yet.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th class="text-end">Vehicles</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>
                            <a class="fw-semibold text-decoration-none"
                               asp-controller="Customers" asp-action="Details" asp-route-id="@c.Id">@c.FullName</a>
                        </td>
                        <td>@(c.Email ?? "—")</td>
                        <td>@(c.Phone ?? "—")</td>
                        <td class="text-end">@c.VehicleCount</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
