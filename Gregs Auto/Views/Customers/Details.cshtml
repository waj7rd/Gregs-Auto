@using Gregs_Auto.ViewModels
@model CustomerDetailsViewModel

@{
    ViewData["Title"] = Model.FullName;
}

<div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-4">
    <div>
        <h1 class="ga-page-title">
            @Model.FullName
            @if (!Model.IsActive)
            {
                <span class="badge text-bg-secondary align-middle ms-2">Archived</span>
            }
        </h1>
        <p class="ga-page-sub mb-0">
            @(Model.Email ?? "no email on file") &middot; @(Model.Phone ?? "no phone on file")
        </p>
    </div>
    <div class="text-nowrap">
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Customers" asp-action="Edit" asp-route-id="@Model.CustomerId">Edit</a>
        <form asp-controller="Customers" asp-action="SetActive" method="post"
              onsubmit="return confirm('@(Model.IsActive ? "Archive this customer? Their history stays on file." : "Put this customer back on the active list?")');"
              class="d-inline">
            <input type="hidden" name="id" value="@Model.CustomerId" />
            <input type="hidden" name="isActive" value="@((!Model.IsActive).ToString())" />
            <button type="submit" class="btn btn-sm @(Model.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                @(Model.IsActive ? "Archive" : "Restore")
            </button>
        </form>
    </div>
</div>

@if (Model.ErrorMessage != null)
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-lg-7">
        <h2 class="h5 mb-3">Vehicles</h2>

        @if (!Model.Vehicles.Any())
        {
            <p class="text-muted">No vehicles on file yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Vehicle</th>
                            <th>VIN</th>
                            <th>Plate</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.Vehicles)
                        {
                            <tr class="@(v.IsActive ? "" : "text-muted")">
                                <td class="fw-semibold">
                                    @v.Year @v.Make @v.Model
                                    @if (!v.IsActive)
                                    {
                                        <span class="badge text-bg-secondary ms-1">Archived</span>
                                    }
                                </td>
                                <td><code class="small">@(v.Vin ?? "—")</code></td>
                                <td>@(v.LicensePlate ?? "—")</td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-secondary" asp-controller="Customers" asp-action="EditVehicle" asp-route-id="@v.Id">Edit</a>
                                    <form asp-controller="Customers" asp-action="SetVehicleActive" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@v.Id" />
                                        <input type="hidden" name="customerId" value="@Model.CustomerId" />
                                        <input type="hidden" name="isActive" value="@((!v.IsActive).ToString())" />
                                        <button type="submit" class="btn btn-sm @(v.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                            @(v.IsActive ? "Archive" : "Restore")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-lg-5">
        <div class="ga-panel">
            <h2 class="h5 mb-3">Add a vehicle</h2>
            <form asp-controller="Customers" asp-action="AddVehicle" method="post" class="row g-3">
                <input type="hidden" asp-for="NewVehicle.CustomerId" />

                <div class="col-4">
                    <label class="form-label" asp-for="NewVehicle.Year">Year</label>
                    <input class="form-control" asp-for="NewVehicle.Year" type="number" />
                </div>
                <div class="col-8">
                    <label class="form-label" asp-for="NewVehicle.Make">Make</label>
                    <input class="form-control" asp-for="NewVehicle.Make" />
                </div>
                <div class="col-12">
                    <span asp-validation-for="NewVehicle.Year" class="text-danger small"></span>
                    <span asp-validation-for="NewVehicle.Make" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label class="form-label" asp-for="NewVehicle.Model">Model</label>
                    <input class="form-control" asp-for="NewVehicle.Model" />
                    <span asp-validation-for="NewVehicle.Model" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="NewVehicle.Vin"></label>
                    <input class="form-control" asp-for="NewVehicle.Vin" placeholder="17 characters, optional" />
                    <span asp-validation-for="NewVehicle.Vin" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="NewVehicle.LicensePlate"></label>
                    <input class="form-control" asp-for="NewVehicle.LicensePlate" />
                    <span asp-validation-for="NewVehicle.LicensePlate" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary w-100">Add vehicle</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
