{
  "ConnectionStrings": {
    "GregsAutoContext": "Server=.;Database=GregsAuto;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "ShopSettings": {
    "TimeZoneId": "America/Chicago",
    "BayCount": 3,
    "OpensAt": "08:00",
    "ClosesAt": "17:00",
    "ClosedDays": [ "Saturday", "Sunday" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",

      // EF logs every query at Information, which drowns everything else.
      "Microsoft.EntityFrameworkCore": "Warning",

      // The app's own logging, kept above the framework noise. Auth failures
      // and honeypot hits come through here.
      "Gregs_Auto": "Information"
    }
  },
  "AllowedHosts": "*"
}
